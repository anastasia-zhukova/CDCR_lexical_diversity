# Local paths for ms-coref — gitignored, not committed.
# Copy this file to config.yaml and update paths for your machine.

output_dir: /path/to/output
checkpoint: /path/to/checkpoint/best_model.pt

# Topic exclusion: when true, filters out noisy topics per dataset before
# training and evaluation. Applies to HyperCoref (Sport/Sports) and WECEng
# (Awards, Beauty Pageant, Concert, Contest, Festival, Solar Eclipse).
# Set to false to run without any topic exclusion.
exclude_topics: true

# Per-dataset topic exclusion sets (only applied when exclude_topics: true).
hypercoref_exclude_topics:
  - Sport
  - Sports
weceng_exclude_topics:
  - Awards
  - Beauty Pageant
  - Concert
  - Contest
  - Festival
  - Solar Eclipse

# Subset of datasets to use for training/validation (from uCDCR's 12).
datasets:
  - HyperCoref
  - NP4E
  - NewsWCL50
  - NIdent
  - ECBplus
  - ECBplusMETAm

# Training mode: "single", "hypercoref_main", "mix"
#   single          – train on one dataset at a time (single_train_dataset)
#   hypercoref_main – train on HyperCoref, evaluate on all `datasets`
#   mix             – train on all `datasets` combined
train_mode: mix

# When train_mode == "single", which dataset to train on. Ignored otherwise.
single_train_dataset: HyperCoref

# Training regime (see core/coref_training_core.py): "ms_loss" (default,
# PK batch sampler + MultiSimilarityLoss) or "contrastive" (SBERT MST/KNN
# pair sampler + margin-based ContrastiveLoss, ported from cl-coref-orig).
# ms-alpha/beta/lambda/tau/gamma are CLI-only flags on train.py.
# contrastive_margin/contrastive_sbert_model/contrastive_k_negatives below
# are optional config.yaml keys (fall back to train.py's CLI defaults if
# omitted); CLI flags still override whatever is set here.
loss_type: ms_loss
# contrastive_margin: 0.7
# contrastive_sbert_model: sentence-transformers/all-mpnet-base-v2
# contrastive_k_negatives: 20

# Fixed clustering threshold for cosine-distance evaluation.
eval_threshold: 0.5

# Full CoNLL evaluation configuration
results_root: /path/to/results_and_weights
data_dir: /path/to/data
repo_dir: /path/to/ms-coref
split: test
batch_size: 256
max_length: 128
mlp_dim: 1024

# All 12 CDCR datasets for full CoNLL evaluation
all_datasets:
  - HyperCoref
  - NP4E
  - NewsWCL50
  - NIdent
  - ECBplus
  - ECBplusMETAm
  - WECEng
  - GVC
  - FCC
  - MEANTIME
  - CD2CR
  - CEREC